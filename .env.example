# Copy to .env (git-ignored) and fill in. Read by docker compose from this folder.

# Optional. Only needed for the Mapbox-hosted basemap styles; the default basemap needs no token.
# Free tier: https://account.mapbox.com/  (rebuild with `docker compose up --build` after changing it)
VITE_MAPBOX_TOKEN=

# Shared GCS bucket for data and models (see README, "Shared data and models")
HEIMDALL_BUCKET=
